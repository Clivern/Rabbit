# DigitalOcean Container Registry image
SLOTH_IMAGE=registry.digitalocean.com/sloth/sloth:main

# Public URL (used in emails, billing redirects, etc.)
SLOTH_SERVER_URL=http://localhost

# Postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=sloth

# Nginx
NGINX_HTTP_PORT=80

# Optional: AI, mail, billing, GitHub/Google OAuth
# SLOTH_LLM_PROVIDER=openrouter
# SLOTH_LLM_API_KEY=
# SLOTH_LLM_CHAT_MODEL=openai/gpt-4o
# SLOTH_RESEND_API_KEY=
# SLOTH_STRIPE_SECRET_KEY=
# SLOTH_STRIPE_WEBHOOK_SECRET=
# SLOTH_GITHUB_OAUTH_CLIENT_ID=
# SLOTH_GITHUB_OAUTH_CLIENT_SECRET=
# SLOTH_GITHUB_OAUTH_REDIRECT_URL=
# SLOTH_GOOGLE_OAUTH_CLIENT_ID=
# SLOTH_GOOGLE_OAUTH_CLIENT_SECRET=
# SLOTH_GOOGLE_OAUTH_REDIRECT_URL=
